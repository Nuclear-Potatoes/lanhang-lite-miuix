<?xml version="1.0" encoding="utf-8"?>
<!-- 外壳：Miuix 顶栏 + Fragment 内容区 + Miuix 底栏（2026-10-24 重做） -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:clipChildren="false">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/shellTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/page_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/shellBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shellTopBar" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/shellBottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 全屏 overlay 宿主：Miuix 的 OverlayDialog 需要有 MiuixPopupHost 才渲染，
         放在外壳最上层才能让遮罩盖住顶栏/底栏（放在页面里只盖内容区）。 -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/shellOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toTopOf="@id/shellBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
