<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 顶栏：Miuix 的周次胶囊 + 网格/周视图分段控件（见 schedule/ScheduleHeader.kt） -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/scheduleHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 周视图内容 -->
            <com.lanhang.miuix.schedule.SwipePagerLayout
                android:id="@+id/contentWeek"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/weekScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/weekContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="16dp">

                        <!-- 7天摘要条 -->
                        <LinearLayout
                            android:id="@+id/dayStrip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginBottom="6dp"
                            android:orientation="horizontal" />

                        <!-- 每天课程区 -->
                        <LinearLayout
                            android:id="@+id/daySections"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/schedule_week_no_course"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </com.lanhang.miuix.schedule.SwipePagerLayout>

            <!-- 网格视图内容 -->
            <com.lanhang.miuix.schedule.SwipePagerLayout
                android:id="@+id/contentGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="@android:color/transparent"
                android:paddingHorizontal="4dp"
                android:paddingVertical="3dp">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/gridScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="0dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/gridContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </androidx.core.widget.NestedScrollView>
            </com.lanhang.miuix.schedule.SwipePagerLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</FrameLayout>
