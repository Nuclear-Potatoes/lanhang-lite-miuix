<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis=30min 是兜底：主力是 ScheduleWidgetUpdater 的分钟心跳，
     但它依赖链式闹钟；闹钟被系统清掉 / 应用被强行停止时，靠系统这 30 分钟一次
     的 onUpdate 把「N 分钟结束」这类陈旧状态救回来。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:description="@string/widget_schedule_wide_description"
    android:initialLayout="@layout/widget_schedule_wide"
    android:minHeight="110dp"
    android:minResizeHeight="90dp"
    android:minResizeWidth="200dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_schedule_wide_preview"
    android:previewLayout="@layout/widget_schedule_wide_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
