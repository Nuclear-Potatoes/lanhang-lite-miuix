<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 工作圈长按保存图片：API 29 起走 MediaStore 不需要权限，28 及以下仍要写外部存储 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 私信的新消息用系统通知提示（im/ImNotify.kt），Android 13+ 需要运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 上课自动勿扰：系统的勿扰权限只能由用户手动授予（ACCESS_NOTIFICATION_POLICY） -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- 上课提醒要准点响（第三十一轮）：Android 12+ 精确闹钟需要单独声明，
         没有授权时退回 setAndAllowWhileIdle，只会晚几分钟 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 私信发语音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 私信发位置（只取一次上次已知点，不做后台定位） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LanhangLite"
        android:usesCleartextTraffic="true">

        <!-- 私信用的融云 IMLib 2.9 的清单里 PushReceiver 没写 android:exported，
             targetSdk 35 合并清单会直接失败；本项目不接推送，显式关掉导出属性覆盖它。 -->
        <receiver
            android:name="io.rong.push.rongpush.PushReceiver"
            android:exported="false"
            tools:node="merge" />
        <receiver
            android:name=".widget.ScheduleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_schedule_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ScheduleWidgetWideProvider"
            android:exported="true"
            android:label="@string/widget_schedule_wide_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_wide_info" />
        </receiver>

        <receiver
            android:name=".widget.ScheduleWidgetSmallProvider"
            android:exported="true"
            android:label="@string/widget_schedule_small_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_small_info" />
        </receiver>

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2026-10-26 第五轮：必须显式写 adjustResize。
             不写时系统按 adjustUnspecified 判成 adjustPan（dumpsys 里 sim={adjust=pan}），
             键盘一弹整个窗口被整体平移，顶栏 / 底栏 / 消息列表全跟着飞出屏幕，
             加上页面自己的 imePadding，表现为「发消息时所有元素被抬到不正常的高度」。 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.OaWebViewActivity"
            android:exported="false" />

        <activity
            android:name=".moments.ImagePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.LanhangLite.ImagePreview" />

        <!-- 2026-10-26：小米推送（MiPush）已移除（用户要求改用普通通知）。
             新消息提示走 im/ImNotify.kt 的系统通知，不需要任何推送 SDK / 组件。 -->
            <!-- 私信里收到的文件先落到 cache，再以 content:// 交给系统应用打开（Android 7+ 禁止 file://） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    <!-- 上课提醒的闹钟与系统事件入口（第三十一轮）：
         开机 / 应用更新 / 改时间时区都必须重排，否则提醒会静默消失到下次打开 App -->
    <receiver
        android:name=".schedule.ClassReminderReceiver"
        android:exported="false">
        <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
            <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            <action android:name="android.intent.action.TIME_SET" />
            <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        </intent-filter>
    </receiver>

</application>

</manifest>
