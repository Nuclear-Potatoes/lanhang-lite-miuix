# 统一换行符：源码用 LF，Windows 脚本用 CRLF，二进制原样
* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.pro text eol=lf
*.properties text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
*.aar binary
*.keystore binary
*.png binary
*.webp binary
*.ttf binary
